# ── Supabase (프로덕션 / 원격 Supabase 사용 시) ──────────────────────────────
# 아래 항목이 없으면 로컬 파일 시스템 어댑터 자동 선택 (data/ & uploads/)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# ── 공통 ──────────────────────────────────────────────────────────────────────
ADMIN_PIN=1234
PORT=3000

# ── 로컬 개발 전용 (로컬 어댑터 사용 시) ────────────────────────────────────
# 이미지 URL에 사용할 호스트 (기본: http://localhost:8765)
# LOCAL_HOST=http://localhost:8765
