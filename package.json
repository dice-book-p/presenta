{
	"name": "presenta",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"vite dev --host\" \"node --env-file=.env server/ws-dev.js\"",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"test": "SUPABASE_URL=https://test.example.co SUPABASE_SERVICE_ROLE_KEY=test node --test tests/*.test.js 2>&1 | grep -v 'persist error'",
		"test:watch": "SUPABASE_URL=https://test.example.co SUPABASE_SERVICE_ROLE_KEY=test node --test --watch tests/*.test.js"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.51.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.99.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"busboy": "^1.6.0",
		"concurrently": "^9.2.1",
		"qrcode": "^1.5.4",
		"sharp": "^0.34.5",
		"ws": "^8.19.0"
	}
}
